{
  "name": "maizes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run levels && vite build",
    "preview": "vite preview",
    "levels": "node src/scripts/buildLevels.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:share": "VITE_NO_DEV=1 npm run build",
    "share": "npm run build:share && vite preview --port 4173",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^4.9.0",
    "globals": "^17.4.0",
    "jsdom": "^30.0.1",
    "vite": "^8.0.1",
    "vitest": "^4.1.10"
  },
  "description": "A maze game where the difficulty is what you cannot see. Collect the maize, outrun the ghost. Every level is generated and proven beatable by a solver before it ships."
}
