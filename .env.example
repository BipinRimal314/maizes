# Playtest telemetry. Leave these unset and telemetry is entirely inert —
# `enabled()` is false, no requests are made, and the notice on the level list
# does not appear. That is the correct state for local development.
#
# To collect playtest stats:
#   1. create a Supabase project
#   2. run supabase/migrations/0001_play_events.sql in its SQL editor
#   3. copy this file to .env.local and fill in the two values below
#
# The anon key is meant to be public — it ships inside the built page. The
# table's RLS grants it INSERT and nothing else, so it cannot read anyone's
# rows back. Never put the service_role key here; it bypasses RLS entirely.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Tags every row, so data from before a difficulty retune stays separable.
VITE_BUILD=playtest-1

# Set on builds you hand to other people. Kills developer mode outright: no
# query string, stored flag or console poking can unlock the campaign, because
# every entry point reports false. `npm run share` sets this for you.
VITE_NO_DEV=1
